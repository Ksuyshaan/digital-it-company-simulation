# ───── База данных (PostgreSQL 15+) ─────
# docker-compose пробрасывает БД на 127.0.0.1:55432 (чтобы не конфликтовать с локальным PostgreSQL)
DATABASE_URL=postgresql://dits:dits@localhost:55432/dits?schema=public

# ───── Сервер ─────
PORT=3000
# адрес API снаружи (для redirect_uri OIDC)
PUBLIC_URL=http://localhost:3000
# адрес(а) фронтенда через запятую — CORS и редирект после входа
FRONTEND_URL=http://localhost:5173
# true за HTTPS
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Almaty
APP_TZ_OFFSET_MIN=300

# ───── Вход ─────
# стартовый домен корпоративной почты (дальше — в админ-панели)
AUTH_DOMAIN=university.kz
# вход по почте без провайдера — ТОЛЬКО для демо и разработки
AUTH_DEV_LOGIN=true
# OIDC: microsoft | google
OIDC_PROVIDER=microsoft
# Microsoft 365: https://login.microsoftonline.com/<TENANT_ID>/v2.0
# Google Workspace: https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# redirect URI для регистрации приложения: ${PUBLIC_URL}/api/auth/callback

# ───── Файлы (S3-совместимое хранилище: SeaweedFS из docker-compose, MinIO или другое) ─────
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=dits
S3_SECRET_KEY=dits-secret-change-me
S3_BUCKET=dits-files

# ───── Антивирус (ClamAV clamd), пусто — без проверки ─────
CLAMAV_HOST=
CLAMAV_PORT=3310

# ───── Почта для уведомлений, пусто — только уведомления в системе ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Digital IT Company <noreply@university.kz>

# ───── Резервные копии ─────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
BACKUP_ENABLED=true

# шрифт с кириллицей для PDF (если не найден автоматически)
PDF_FONT=
