// Digital IT Company Simulation — схема БД (PostgreSQL 15+)
// Идентификаторы — строки: демо-данные используют читаемые id (u12, tm1…), новые записи — cuid.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Пользователь системы. Роль глобальная: student | teacher | assistant | admin
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  group           String    @default("")
  role            String    @default("student")
  about           String    @default("")
  skills          Json      @default("[]")
  wantedRoles     Json      @default("[]")
  links           Json      @default("[]")
  photoFileId     String?
  lastActiveAt    DateTime?
  blocked         Boolean   @default(false)
  profileFilledAt DateTime?
  /// согласие с тем, что переписку видит преподаватель (п. 8)
  consentAt       DateTime?
  createdAt       DateTime  @default(now())

  enrollments   Enrollment[]
  sessions      Session[]
  notifications Notification[]
}

/// Курс (поток). Настройки курса — JSON в формате CourseSettings фронтенда
model Course {
  id                String    @id @default(cuid())
  name              String
  stream            String
  start             DateTime
  weeks             Int       @default(15)
  teacherId         String
  status            String    @default("active") // active | archive
  keepUntil         String?
  settings          Json
  inviteCode        String?   @unique
  formationOpen     Boolean   @default(false)
  formationDeadline DateTime?
  frozenAt          DateTime?
  createdAt         DateTime  @default(now())

  enrollments Enrollment[]
  teams       Team[]
  channels    Channel[]
  assignments Assignment[]
  locks       Lock[]
}

/// Участие пользователя в курсе: команда и роль в ней — на уровне курса
model Enrollment {
  id            String  @id @default(cuid())
  userId        String
  courseId      String
  teamId        String?
  teamRole      String?
  /// РД неделю назад (колонка «изменение за неделю»)
  rdWeekAgo     Float   @default(0)
  /// личная корректировка балла проекта преподавателем, доля (−0.2…+0.2)
  projectAdjust Float?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
}

/// Команда. stage = formation — черновик в окне формирования; active — утверждённая после заморозки
model Team {
  id               String   @id @default(cuid())
  courseId         String
  name             String
  idea             String   @default("")
  initiatorId      String
  stage            String   @default("active") // formation | active
  status           String   @default("draft") // draft | pending | approved | returned
  returnComment    String?
  approvedOverride String?
  /// роли участников на этапе формирования: { userId: TeamRole }
  roles            Json?
  /// черновые участники (stage = formation); у активных команд — через Enrollment.teamId
  draftMemberIds   Json     @default("[]")
  projectScore     Float    @default(0)
  channelId        String?
  cardSeq          Int      @default(0)
  /// кто уже был Scrum Master (для ротации)
  smHistory        Json     @default("[]")
  createdAt        DateTime @default(now())

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members  Enrollment[]
  sprints  Sprint[]
  cards    Card[]
  requests FormationRequest[]

  @@index([courseId, stage])
}

model FormationRequest {
  id        String   @id @default(cuid())
  courseId  String
  teamId    String
  studentId String
  kind      String // request | invite
  at        DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Sprint {
  id       String    @id @default(cuid())
  teamId   String
  number   Int
  name     String
  goal     String
  start    DateTime
  end      DateTime
  status   String // planned | active | closed
  closedAt DateTime?
  report   Json?

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  retro Retro?

  @@index([teamId])
}

model Card {
  id                 String    @id @default(cuid())
  key                String
  teamId             String
  sprintId           String?
  column             String    @default("backlog")
  title              String
  description        String    @default("")
  assigneeId         String?
  deadline           DateTime?
  priority           String    @default("mid")
  sp                 Int?
  labels             Json      @default("[]")
  checklist          Json      @default("[]")
  files              Json      @default("[]")
  authorId           String
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  closedAt           DateTime?
  archived           Boolean   @default(false)
  notifiedDeadlineAt DateTime?
  notifiedOverdueAt  DateTime?

  team     Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  comments CardComment[]

  @@index([teamId])
  @@index([sprintId])
}

model CardComment {
  id       String   @id @default(cuid())
  cardId   String
  authorId String
  text     String
  at       DateTime @default(now())
  files    Json     @default("[]")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// История изменений карточек — только добавление
model HistoryEntry {
  id     String   @id @default(cuid())
  cardId String
  teamId String
  userId String
  at     DateTime @default(now())
  field  String
  from   String
  to     String
  note   String?

  @@index([teamId])
  @@index([cardId])
}

model Channel {
  id       String  @id @default(cuid())
  courseId String
  kind     String // general | announcements | team
  name     String
  teamId   String?

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([courseId])
}

model Message {
  id           String    @id @default(cuid())
  channelId    String
  authorId     String
  text         String
  at           DateTime  @default(now())
  parentId     String?
  files        Json      @default("[]")
  reactions    Json      @default("{}")
  editedAt     DateTime?
  originalText String?
  deletedAt    DateTime?
  deletedById  String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, at])
  @@index([authorId])
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String
  openAt      DateTime
  deadline    DateTime
  maxScore    Float
  criteria    Json
  format      String // file | link | text
  peerReview  Boolean  @default(false)
  isControl   Boolean  @default(false)
  locked      Boolean  @default(false)
  files       Json     @default("[]")
  /// рецензенты назначены автоматически
  reviewersAt DateTime?
  createdAt   DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId])
}

model Submission {
  id             String    @id @default(cuid())
  assignmentId   String
  studentId      String
  teacherScores  Json?
  teacherComment String?
  gradedAt       DateTime?
  extensionUntil DateTime?

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  versions   SubmissionVersion[]
  reviews    Review[]

  @@unique([assignmentId, studentId])
}

model SubmissionVersion {
  id           String   @id @default(cuid())
  submissionId String
  at           DateTime @default(now())
  content      String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Review {
  id                String    @id @default(cuid())
  submissionId      String
  reviewerId        String
  scores            Json?
  comment           String    @default("")
  assignedAt        DateTime  @default(now())
  doneAt            DateTime?
  disputeReason     String?
  disputedAt        DateTime?
  disputeResolution String? // kept | removed

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
}

model Retro {
  id       String @id @default(cuid())
  sprintId String @unique
  teamId   String

  sprint  Sprint        @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  items   RetroItem[]
  ratings RetroRating[]
}

model RetroItem {
  id       String   @id @default(cuid())
  retroId  String
  authorId String
  col      String // good | bad | change
  text     String
  at       DateTime @default(now())

  retro Retro @relation(fields: [retroId], references: [id], onDelete: Cascade)
}

model RetroRating {
  id      String @id @default(cuid())
  retroId String
  fromId  String
  toId    String
  score   Int

  retro Retro @relation(fields: [retroId], references: [id], onDelete: Cascade)

  @@unique([retroId, fromId, toId])
}

model PointAdjustment {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  component String // A | K | P
  delta     Float
  reason    String
  byId      String
  at        DateTime @default(now())

  @@index([courseId])
}

/// Журнал действий: кто, когда, что, объект, старое/новое значение, IP. Изменение и удаление запрещены триггером
model AuditEntry {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  userId     String
  courseId   String?
  text       String
  objectType String?
  objectId   String?
  oldValue   String?
  newValue   String?
  ip         String?

  @@index([courseId, at])
  @@index([at])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  courseId  String?
  at        DateTime  @default(now())
  text      String
  link      String
  kind      String
  read      Boolean   @default(false)
  emailedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

model Lock {
  id          String    @id @default(cuid())
  courseId    String
  scope       String // all | team | assignment
  targetId    String?
  reason      String
  from        DateTime
  createdById String
  cancelled   Boolean   @default(false)
  /// момент, когда планировщик разослал событие о включении
  firedAt     DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model DismissedSignal {
  courseId String
  signalId String
  at       DateTime @default(now())

  @@id([courseId, signalId])
}

model ManualBadge {
  id       String   @id @default(cuid())
  courseId String
  userId   String
  key      String
  byId     String
  at       DateTime @default(now())

  @@unique([courseId, userId, key])
}

model FileObject {
  id         String   @id @default(cuid())
  name       String
  size       Int
  mime       String
  storageKey String   @unique
  uploaderId String
  courseId   String?
  teamId     String?
  /// контекст, определяющий доступ: channel | card | submission | assignment | photo | other
  context    String   @default("other")
  scanStatus String   @default("skipped") // clean | skipped
  createdAt  DateTime @default(now())

  @@index([teamId])
}

model Session {
  id         String   @id // sha256 токена
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ежедневные снимки РД — для колонки «изменение за неделю»
model RatingSnapshot {
  id       String   @id @default(cuid())
  courseId String
  userId   String
  at       DateTime @default(now())
  rd       Float

  @@index([courseId, at])
}

/// Системные настройки (одна строка): вход, домен, сессии, резервные копии
model SystemSettings {
  id   Int  @id @default(1)
  data Json
}
